# --- Base de datos (los usa docker compose para crear el contenedor de Postgres) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=noxi

# --- API ---
PORT=3000
CORS_ORIGIN=http://localhost:4200
# Solo para desarrollo local sin Docker (dentro de docker compose se sobrescribe hacia el servicio "db")
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/noxi
JWT_SECRET=
JWT_EXPIRES_IN=1h
